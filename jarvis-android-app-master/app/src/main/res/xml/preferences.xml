
<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <EditTextPreference
        android:key="geminiApiKey"
        android:title="Gemini API Key"
        android:summary="Enter your Gemini API key. Stored on this device."
        android:dialogTitle="Gemini API Key"
        android:defaultValue=""
        android:selectAllOnFocus="true"
        android:singleLine="true" />

    <SwitchPreference
        android:key="muteLocalJarvis"
        android:defaultValue="false"
        android:title="Mute spoken responses" />

    <SwitchPreference
        android:key="sttAtStart"
        android:defaultValue="false"
        android:title="Start with voice recognition" />

</PreferenceScreen>
